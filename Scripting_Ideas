#!/bin/bash
#
# Simple Linux Digital Forensics Collection Tool
# Author: Garrett (for IT project)
# Description:
#   - Collects basic system, user, network, process, and log artifacts
#   - Preserves evidence in a timestamped directory
#   - Generates SHA-256 hashes for integrity
#   - Packages everything into a tar.gz archive
#
# Usage:
#   sudo ./forensic_collection.sh

set -u  # treat unset variables as an error

SCRIPT_VERSION="1.0"

# ----------------------- Global Variables -----------------------

TIMESTAMP="$(date +"%Y%m%d_%H%M%S")"
HOSTNAME_STR="$(hostname 2>/dev/null || echo "unknown_host")"
BASE_DIR="evidence_${HOSTNAME_STR}_${TIMESTAMP}"

SYSTEM_DIR="${BASE_DIR}/system"
USER_DIR="${BASE_DIR}/user"
NETWORK_DIR="${BASE_DIR}/network"
LOGS_DIR="${BASE_DIR}/logs"
PROCESS_DIR="${BASE_DIR}/processes"
MISC_DIR="${BASE_DIR}/misc"

LOG_FILE="${BASE_DIR}/collection.log"
HASH_FILE="${BASE_DIR}/hashes.sha256"

ARCHIVE_NAME="${BASE_DIR}.tar.gz"

# ----------------------- Helper Functions -----------------------

log_msg() {
    # log_msg LEVEL MESSAGE
    local level="$1"
    shift
    local msg="$*"
    local now
    now="$(date +"%Y-%m-%d %H:%M:%S")"
    echo "[$now] [$level] $msg" | tee -a "$LOG_FILE" >/dev/null
}

ensure_dir() {
    local dir="$1"
    if [ ! -d "$dir" ]; then
        mkdir -p "$dir" 2>/dev/null || {
            echo "Failed to create directory: $dir" >&2
            exit 1
        }
    fi
}

run_and_save() {
    # run_and_save OUTPUT_FILE COMMAND [ARGS...]
    local out_file="$1"
    shift
    local cmd="$1"

    if ! command -v "$cmd" >/dev/null 2>&1; then
        log_msg "WARN" "Command not found: $cmd (requested for $out_file)"
        return
    fi

    log_msg "INFO" "Running command: $* -> $out_file"
    # shellcheck disable=SC2124
    "$@" >"$out_file" 2>>"$LOG_FILE" || {
        log_msg "ERROR" "Command failed: $*"
    }
}

copy_if_exists() {
    # copy_if_exists SOURCE_FILE DEST_FILE
    local src="$1"
    local dest="$2"

    if [ -f "$src" ]; then
        log_msg "INFO" "Copying file: $src -> $dest"
        cp "$src" "$dest" 2>>"$LOG_FILE" || {
            log_msg "ERROR" "Failed to copy $src to $dest"
        }
    else
        log_msg "WARN" "File not found (skip): $src"
    fi
}

# ----------------------- Collection Functions -----------------------

init_environment() {
    ensure_dir "$BASE_DIR"
    ensure_dir "$SYSTEM_DIR"
    ensure_dir "$USER_DIR"
    ensure_dir "$NETWORK_DIR"
    ensure_dir "$LOGS_DIR"
    ensure_dir "$PROCESS_DIR"
    ensure_dir "$MISC_DIR"

    touch "$LOG_FILE" 2>/dev/null || {
        echo "Failed to create log file at $LOG_FILE" >&2
        exit 1
    }

    log_msg "INFO" "Starting forensic collection"
    log_msg "INFO" "Script version: $SCRIPT_VERSION"
    log_msg "INFO" "Base directory: $BASE_DIR"
    log_msg "INFO" "Host: $HOSTNAME_STR"
    log_msg "INFO" "Running as user: $(whoami)"
}

collect_system_info() {
    log_msg "INFO" "Collecting system information"

    run_and_save "${SYSTEM_DIR}/os_uname.txt" uname -a
    copy_if_exists "/etc/os-release" "${SYSTEM_DIR}/os-release.txt"
    run_and_save "${SYSTEM_DIR}/cpu_lscpu.txt" lscpu
    run_and_save "${SYSTEM_DIR}/block_lsblk.txt" lsblk
    run_and_save "${SYSTEM_DIR}/disk_df_h.txt" df -h
    run_and_save "${SYSTEM_DIR}/memory_free_h.txt" free -h

    # Kernel modules, if available
    run_and_save "${SYSTEM_DIR}/loaded_modules_lsmod.txt" lsmod

    # Mounted filesystems
    run_and_save "${SYSTEM_DIR}/mounts.txt" cat /proc/mounts
}

collect_user_info() {
    log_msg "INFO" "Collecting user information"

    run_and_save "${USER_DIR}/who.txt" who
    run_and_save "${USER_DIR}/w.txt" w
    run_and_save "${USER_DIR}/last_logins.txt" last -F

    copy_if_exists "/etc/passwd" "${USER_DIR}/passwd.txt"
    copy_if_exists "/etc/group" "${USER_DIR}/group.txt"
    copy_if_exists "/etc/shadow" "${USER_DIR}/shadow.txt"  # may fail if not root

    # Current user ID details
    run_and_save "${USER_DIR}/current_user_id.txt" id

    # Attempt to collect shell histories
    log_msg "INFO" "Attempting to collect shell history files"
    for home_dir in /root /home/*; do
        if [ -d "$home_dir" ]; then
            user_name="$(basename "$home_dir")"
            for hist_file in ".bash_history" ".zsh_history" ".sh_history"; do
                if [ -f "${home_dir}/${hist_file}" ]; then
                    dest="${USER_DIR}/${user_name}_${hist_file}.txt"
                    copy_if_exists "${home_dir}/${hist_file}" "$dest"
                fi
            done
        fi
    done
}

collect_network_info() {
    log_msg "INFO" "Collecting network information"

    run_and_save "${NETWORK_DIR}/ip_addr.txt" ip addr
    run_and_save "${NETWORK_DIR}/ip_route.txt" ip route

    # Fallback to ifconfig if ip is not available
    if ! command -v ip >/dev/null 2>&1 && command -v ifconfig >/dev/null 2>&1; then
        run_and_save "${NETWORK_DIR}/ifconfig.txt" ifconfig -a
    fi

    # Connections: prefer ss, fallback to netstat
    if command -v ss >/dev/null 2>&1; then
        run_and_save "${NETWORK_DIR}/network_ss_tulnp.txt" ss -tulnp
    else
        run_and_save "${NETWORK_DIR}/network_netstat_tulnp.txt" netstat -tulnp
    fi

    copy_if_exists "/etc/hosts" "${NETWORK_DIR}/hosts.txt"
    copy_if_exists "/etc/resolv.conf" "${NETWORK_DIR}/resolv.conf.txt"

    # ARP table if available
    if command -v ip >/dev/null 2>&1; then
        run_and_save "${NETWORK_DIR}/arp_table.txt" ip neigh
    elif command -v arp >/dev/null 2>&1; then
        run_and_save "${NETWORK_DIR}/arp_table.txt" arp -an
    fi
}

collect_logs() {
    log_msg "INFO" "Collecting log files (this may take a while)"

    # systemd journal (last 24 hours)
    if command -v journalctl >/dev/null 2>&1; then
        run_and_save "${LOGS_DIR}/journal_last24h.txt" journalctl --no-pager --since "24 hours ago"
    else
        log_msg "WARN" "journalctl not available; skipping journal collection"
    fi

    # Common log files
    copy_if_exists "/var/log/syslog" "${LOGS_DIR}/syslog.txt"
    copy_if_exists "/var/log/messages" "${LOGS_DIR}/messages.txt"
    copy_if_exists "/var/log/auth.log" "${LOGS_DIR}/auth.log.txt"
    copy_if_exists "/var/log/secure" "${LOGS_DIR}/secure.log.txt"
    copy_if_exists "/var/log/dmesg" "${LOGS_DIR}/dmesg.log.txt"

    # dmesg command output
    run_and_save "${LOGS_DIR}/dmesg_cmd_output.txt" dmesg
}

collect_process_info() {
    log_msg "INFO" "Collecting process and open file information"

    run_and_save "${PROCESS_DIR}/ps_aux.txt" ps aux

    if command -v pstree >/dev/null 2>&1; then
        run_and_save "${PROCESS_DIR}/pstree.txt" pstree -p
    fi

    # lsof can be heavy but useful; may require root
    if command -v lsof >/dev/null 2>&1; then
        run_and_save "${PROCESS_DIR}/lsof_all.txt" lsof -nP
    else
        log_msg "WARN" "lsof not found; skipping open file listing"
    fi
}

collect_misc_info() {
    log_msg "INFO" "Collecting miscellaneous configuration data"

    # Cron jobs
    run_and_save "${MISC_DIR}/crontab_current_user.txt" crontab -l

    # System-wide cron if exists
    copy_if_exists "/etc/crontab" "${MISC_DIR}/etc_crontab.txt"
    if [ -d "/etc/cron.d" ]; then
        ensure_dir "${MISC_DIR}/cron_d"
        cp -r /etc/cron.d/* "${MISC_DIR}/cron_d/" 2>>"$LOG_FILE" || true
    fi

    # Important config directories listing (without contents)
    run_and_save "${MISC_DIR}/etc_tree.txt" ls -R /etc

    # Installed packages (Debian-based: dpkg; RPM-based: rpm)
    if command -v dpkg >/dev/null 2>&1; then
        run_and_save "${MISC_DIR}/installed_packages_dpkg.txt" dpkg -l
    elif command -v rpm >/dev/null 2>&1; then
        run_and_save "${MISC_DIR}/installed_packages_rpm.txt" rpm -qa
    else
        log_msg "WARN" "No package manager (dpkg/rpm) found; skipping package list"
    fi
}

hash_and_package() {
    log_msg "INFO" "Generating hashes for collected evidence"

    if command -v sha256sum >/dev/null 2>&1; then
        find "$BASE_DIR" -type f ! -name "$(basename "$HASH_FILE")" -exec sha256sum {} \; >"$HASH_FILE" 2>>"$LOG_FILE" || {
            log_msg "ERROR" "Failed to generate SHA-256 hashes"
        }
    elif command -v md5sum >/dev/null 2>&1; then
        HASH_FILE="${BASE_DIR}/hashes.md5"
        find "$BASE_DIR" -type f ! -name "$(basename "$HASH_FILE")" -exec md5sum {} \; >"$HASH_FILE" 2>>"$LOG_FILE" || {
            log_msg "ERROR" "Failed to generate MD5 hashes"
        }
    else
        log_msg "ERROR" "No hashing utility (sha256sum/md5sum) found; skipping hash generation"
    fi

    log_msg "INFO" "Packaging evidence directory into archive: ${ARCHIVE_NAME}"

    tar -czf "$ARCHIVE_NAME" "$BASE_DIR" 2>>"$LOG_FILE" || {
        log_msg "ERROR" "Failed to create archive: $ARCHIVE_NAME"
        return
    }

    if command -v sha256sum >/dev/null 2>&1; then
        run_and_save "${ARCHIVE_NAME}.sha256" sha256sum "$ARCHIVE_NAME"
    elif command -v md5sum >/dev/null 2>&1; then
        run_and_save "${ARCHIVE_NAME}.md5" md5sum "$ARCHIVE_NAME"
    fi
}

print_summary() {
    echo
    echo "============================================================"
    echo " Forensic collection complete"
    echo " Base directory: $BASE_DIR"
    echo " Log file:       $LOG_FILE"
    echo " Archive:        $ARCHIVE_NAME"
    echo "============================================================"
    echo
}

# ----------------------- Main -----------------------

main() {
    init_environment
    collect_system_info
    collect_user_info
    collect_network_info
    collect_logs
    collect_process_info
    collect_misc_info
    hash_and_package
    log_msg "INFO" "Forensic collection completed successfully"
    print_summary
}

main "$@"
